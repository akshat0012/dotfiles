#####################################################
# Take Screenshot
super + shift + s
    shotgun -f png ~/ss/s_$(date +%s).png

Toggle mute
XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

#####################################################

# terminal emulator
super + Return
	alacritty

# browser
super + b
    firefox

# program launcher
super + space
	dmenu_run

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

#
# bspwm hotkeys
#

# quit/restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# close and kill
super + shift + q
	bspc node -c

# alternate between the tiled and monocle layout
super + h
	bspc desktop -g hidden

# set the window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# set the node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

# Move the node in the given direction
ctrl + alt + shift + {Left,Down,Up, Right}
	bspc node -s {west,south,north,east}

# focus the node in the given direction
ctrl + alt + {Left,Down,Up, Right}
	bspc node -f {west,south,north,east}

#
# move/resize
#

# Switch to previous/next desktop
super + {Left,Right}
    bspc desktop -f {prev,next}

# Send window to next/previous desktop using arrow keys
super + shift + {Left,Right}
    bspc node -d {prev,next} --follow


# expand a window by moving one of its side outward
super + ctrl + shift + {Left,Down,Up,Right}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window by moving one of its side inward
super + ctrl + {Left,Down,Up,Right}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
super + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}
